<xml version="Mixly 2.0 rc3" board="Arduino AVR@Arduino/Genuino Uno"><block type="base_setup" id="fixed_forward_1" x="30" y="30"><comment pinned="false" h="110" w="350">独立左平移测试。沿用网格程序的左平移方向，PWM依次为120、105、120、135。上电停车，KEY1左平移5200毫秒自动停；每次只左平移，用户只需量距离。运行中按KEY1或串口0提前停，该次作废。</comment><statement name="DO"><block type="variables_declare" id="fixed_forward_2"><field name="variables_type">global_variate</field><field name="VAR">左后方向</field><field name="TYPE">int</field><value name="VALUE"><shadow type="math_number"><field name="NUM">0</field></shadow></value><next><block type="variables_declare" id="fixed_forward_3"><field name="variables_type">global_variate</field><field name="VAR">右后方向</field><field name="TYPE">int</field><value name="VALUE"><shadow type="math_number"><field name="NUM">0</field></shadow></value><next><block type="variables_declare" id="fixed_forward_4"><field name="variables_type">global_variate</field><field name="VAR">左前方向</field><field name="TYPE">int</field><value name="VALUE"><shadow type="math_number"><field name="NUM">1</field></shadow></value><next><block type="variables_declare" id="fixed_forward_5"><field name="variables_type">global_variate</field><field name="VAR">右前方向</field><field name="TYPE">int</field><value name="VALUE"><shadow type="math_number"><field name="NUM">1</field></shadow></value><next><block type="variables_declare" id="fixed_forward_6"><field name="variables_type">global_variate</field><field name="VAR">左平移1号PWM</field><field name="TYPE">int</field><value name="VALUE"><shadow type="math_number"><field name="NUM">120</field></shadow></value><next><block type="variables_declare" id="fixed_forward_7"><field name="variables_type">global_variate</field><field name="VAR">左平移2号PWM</field><field name="TYPE">int</field><value name="VALUE"><shadow type="math_number"><field name="NUM">105</field></shadow></value><next><block type="variables_declare" id="fixed_forward_8"><field name="variables_type">global_variate</field><field name="VAR"